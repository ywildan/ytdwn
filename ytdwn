#!/bin/bash
# ytdwn - YouTube Downloader TUI
# Jalankan ini dari terminal mana saja

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]:-$0}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
cd "$SCRIPT_DIR" || exit 1

if [ ! -d ".venv" ]; then
    echo "❌ Virtual environment tidak ditemukan. Jalankan setup dulu:"
    echo "   cd $SCRIPT_DIR && python3 -m venv .venv && .venv/bin/pip install textual"
    exit 1
fi

.venv/bin/python tui.py
